{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {"@shared/*": ["./src/shared/*"]},
    "noEmit": true
  },
  "include": ["src", "test", "electron.vite.config.ts", "vitest.config.ts"]
}
